ACTION_IF FILE_EXISTS_IN_GAME highhedg.sto THEN BEGIN	 //Thalantyr泰蓝提尔 High Hedge高篱堡
	COPY_EXISTING ~highhedg.sto~ ~override~
		ADD_STORE_ITEM ~Z#BOOK1~ LAST #1 #0 #0 ~IDENTIFIED~ #1
		ADD_STORE_ITEM ~Z#BOOK2~ LAST #1 #0 #0 ~IDENTIFIED~ #1
